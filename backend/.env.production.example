# ==========================================
# MO2 Loyalty Platform - Production Environment
# ==========================================

NODE_ENV=production
PORT=4000

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=loyalty_prod_user
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=loyalty_prod_db
DATABASE_URL=postgres://loyalty_prod_user:generate_strong_password_here@postgres:5432/loyalty_prod_db

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_strong_redis_auth_token

# ------------------------------------------
# Authentication & Cryptographic Secrets
# ------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=generate_unique_jwt_secret_minimum_64_characters
JWT_REFRESH_SECRET=generate_unique_jwt_refresh_secret_minimum_64_characters

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
